{
  "name": "myitaru",
  "private": true,
  "version": "1.0.0",
  "description": "MYITARU: sistem informasi manajemen dan rekam medis elektronik berbasis AI, terdiri atas web publik pasien dan aplikasi inti.",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimzzthareza231-design/MYAPP.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "check:deploy": "node scripts/check-deployment.mjs",
    "build": "node scripts/check-deployment.mjs && vite build && vite build -c vite.public.config.ts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "build:core": "vite build",
    "build:public": "vite build -c vite.public.config.ts",
    "vercel-build:core": "vite build",
    "vercel-build:public": "vite build -c vite.public.config.ts && node -e \"require('fs').copyFileSync('dist/public/public.html','dist/public/index.html')\"",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "cf:build": "vite build --mode cloudflare && vite build -c vite.public.config.ts --mode cloudflare && node -e \"require('fs').copyFileSync('dist/public/public.html','dist/public/index.html')\"",
    "cf:migrate:local": "wrangler d1 migrations apply myitaru-db --local --env core",
    "cf:migrate": "wrangler d1 migrations apply myitaru-db --remote --env core",
    "cf:dev:public": "wrangler dev --env public --port 8787",
    "cf:dev:core": "wrangler dev --env core --port 8788",
    "cf:deploy": "npm run cf:build && wrangler deploy --env public && wrangler deploy --env core",
    "agent:check": "node scripts/agent-dispatch.mjs check",
    "agent:light": "node scripts/agent-dispatch.mjs light",
    "agent:assist": "node scripts/agent-dispatch.mjs assist",
    "agent:auto": "node scripts/agent-dispatch.mjs auto",
    "agent:parallel": "node scripts/agent-dispatch.mjs parallel",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.5.1",
    "html2canvas-pro": "^2.3.7",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.26.0",
    "motion": "^12.42.2",
    "mysql2": "^3.15.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hot-toast": "^2.6.0",
    "react-is": "^19.2.8",
    "react-quill-new": "3.7.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "eslint": "^10.15.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~7.0.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "glob": "^14.0.6",
    "quill": "2.0.2",
    "react": "$react",
    "react-dom": "$react-dom",
    "react-is": "$react-is",
    "iconv-lite": "^0.7.3"
  }
}
