{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": { "bun": ">=1.4.5", "node": ">=22" },
  "scripts": {
    "dev": "bun server.ts",
    "dev:main": "bun server.ts",
    "dev:public": "vite --config apps/public/vite.config.ts",
    "check:deploy": "bun scripts/check-deployment.js",
    "build:main": "vite build --config apps/main/vite.config.ts",
    "build:public": "vite build --config apps/public/vite.config.ts",
    "build:server": "bun scripts/build-server.mjs",
    "build": "bun run check:deploy && bun run build:main && bun run build:public && bun run build:server",
    "start": "NODE_ENV=production bun dist/server/index.cjs",
    "preview": "vite preview --config apps/public/vite.config.ts",
    "test": "bun test tests/api.test.ts tests/boundaries.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck"
  },
  "dependencies": {
    "@google/genai": "^3.3.0", "@tailwindcss/vite": "^4.1.14", "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1", "dotenv": "^17.2.3", "express": "^4.21.2", "firebase": "^12.18.0",
    "glob": "^13.0.6", "html2canvas-pro": "^2.3.7", "jspdf": "^4.2.1", "jsqr": "^1.4.0",
    "leaflet": "^1.9.4", "lucide-react": "^1.26.0", "motion": "^12.42.2", "qrcode.react": "^4.2.0",
    "react": "^19.0.1", "react-dom": "^19.0.1", "react-hot-toast": "^2.6.0", "react-is": "^19.2.8",
    "react-leaflet": "^5.0.0", "react-quill": "^2.0.0", "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1", "tailwind-merge": "^3.6.0", "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2", "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22", "@types/node": "^22.14.0", "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4", "autoprefixer": "^10.4.21", "esbuild": "^0.25.0",
    "eslint": "^10.15.0", "tailwindcss": "^4.1.14", "tsx": "^4.21.0", "typescript": "~5.8.2",
    "vite": "^6.2.3", "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": { "react": "$react", "react-dom": "$react-dom", "react-is": "$react-is" }
}
