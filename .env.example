VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_AUTH_MODE=local
VITE_STORAGE_MODE=mysql
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=


# Pemisahan web publik & aplikasi inti
PUBLIC_PORT=3000
# Kunci tanda tangan token sesi pasien & karyawan (minimal 32 karakter di produksi)
SESSION_SECRET=
CORE_PORT=3001

# Pilihan autentikasi: local (intranet, tanpa Firebase) atau firebase.
AUTH_MODE=local

# Hanya untuk development: akun demo per role memakai sandi <username>123. Jangan gunakan di produksi.
LOCAL_AUTH_ADMIN_EMAIL=
# Wajib di produksi dengan AUTH_MODE=local. Simpan JSON akun bootstrap sebagai secret environment.
LOCAL_AUTH_BOOTSTRAP_USERS_JSON=

# Identitas staf aplikasi inti (wajib hanya saat AUTH_MODE=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Service account khusus akses Firestore REST di Cloudflare Workers; jangan commit kredensialnya.
FIRESTORE_SERVICE_ACCOUNT_JSON=
FIRESTORE_DATABASE_ID=(default)

# Aktifkan hanya untuk uji login gateway karyawan lokal; tidak pernah diizinkan saat produksi
ALLOW_INSECURE_DEMO_AUTH=false

# Kunci dan pilihan model Gemini hanya untuk server.
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Pilihan mode penyimpanan. Gunakan memory hanya untuk demo lokal.
STORAGE_MODE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_myitaru
MYITARU_QR_SECRET=

# Verifikasi Cloudflare Turnstile (rahasia hanya di server)
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_EXPECTED_HOSTNAME=
CLOUDFLARE_TURNSTILE_EXPECTED_ACTION=login
