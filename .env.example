# Canonical package manager: Bun 1.4.5 (bun install --frozen-lockfile)
# PUBLIC website: no Firebase credentials, patient data, or private API URL.
VITE_MAIN_APP_URL=
VITE_PUBLIC_CONTACT=
# Authenticated application (build-time Firebase WEB config, not admin secrets).
VITE_PUBLIC_SITE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=(default)
# Server runtime: same Firebase project and database as the authenticated app.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
MAIN_APP_ORIGIN=
PORT=3000
# Default false. Set only for an isolated, disposable preview environment.
VITE_ENABLE_PREVIEW_MODULES=false
# Set proxy hops only when the server is actually behind a trusted proxy.
TRUST_PROXY_HOPS=0
