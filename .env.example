VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_AUTH_MODE=local
VITE_STORAGE_MODE=mysql
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=


# Pemisahan web publik & aplikasi inti
PUBLIC_PORT=3000
# Kunci tanda tangan token sesi pasien & karyawan (minimal 32 karakter di produksi)
SESSION_SECRET=
CORE_PORT=3001

# Pilihan autentikasi: local (intranet, tanpa Firebase) atau firebase.
AUTH_MODE=local

# Akun lokal awal dibuat sekali saat server berjalan; gunakan sandi unik kuat minimal 12 karakter.
# Nilai sandi hanya dibaca server dan disimpan sebagai hash scrypt.
LOCAL_AUTH_ADMIN_EMAIL=
LOCAL_AUTH_ADMIN_PASSWORD=
LOCAL_AUTH_DOKTER_PASSWORD=
LOCAL_AUTH_PERAWAT_PASSWORD=
LOCAL_AUTH_RMIK_PASSWORD=
LOCAL_AUTH_APOTEKER_PASSWORD=
LOCAL_AUTH_KASIR_PASSWORD=
# true: peran admin (super_admin/admin/it_support) wajib mendaftarkan MFA TOTP sebelum mengakses API lain.
# Memerlukan SESSION_SECRET tetap; mengganti SESSION_SECRET membuat rahasia MFA tidak dapat dibaca.
LOCAL_AUTH_REQUIRE_MFA=false

# Identitas staf aplikasi inti (wajib hanya saat AUTH_MODE=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Aktifkan hanya untuk uji login gateway karyawan lokal; tidak pernah diizinkan saat produksi
ALLOW_INSECURE_DEMO_AUTH=false

# Kunci Gemini hanya untuk server; model utama gemini-2.5-flash
GEMINI_API_KEY=

# Pilihan mode penyimpanan. Gunakan memory hanya untuk demo lokal.
STORAGE_MODE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_myitaru
MYITARU_QR_SECRET=
# Token server-ke-server (header X-Dispatch-Token) untuk /api/v1/patient-notifications/dispatch di web publik.
# Kosongkan untuk menonaktifkan dispatch di luar mode demo (STORAGE_MODE=memory).
PATIENT_NOTIFY_DISPATCH_TOKEN=

# Verifikasi Cloudflare Turnstile (rahasia hanya di server)
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_EXPECTED_HOSTNAME=
CLOUDFLARE_TURNSTILE_EXPECTED_ACTION=login
