# Server (Node: .env; Cloudflare: `wrangler secret put <NAMA>`). Semua opsional.
GEMINI_API_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
FCM_SERVER_KEY=
PORT=3000

# Frontend, hanya untuk push FCM:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
# Tautan "Masuk staf" di web publik (default: domain tanpa www + /staff/login):
VITE_CORE_APP_URL=
