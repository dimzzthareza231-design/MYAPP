VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_AUTH_MODE=local
VITE_STORAGE_MODE=mysql
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=


# Pemisahan web publik & aplikasi inti
PUBLIC_PORT=3000
# Kunci tanda tangan token sesi pasien & karyawan (minimal 32 karakter di produksi)
SESSION_SECRET=
CORE_PORT=3001

# Pilihan autentikasi: local (intranet, tanpa Firebase) atau firebase.
AUTH_MODE=local

# Akun lokal awal dibuat sekali saat server berjalan; gunakan sandi unik kuat minimal 12 karakter.
# Nilai sandi hanya dibaca server dan disimpan sebagai hash scrypt.
LOCAL_AUTH_ADMIN_EMAIL=
LOCAL_AUTH_ADMIN_PASSWORD=
LOCAL_AUTH_DOKTER_PASSWORD=
LOCAL_AUTH_PERAWAT_PASSWORD=
LOCAL_AUTH_RMIK_PASSWORD=
LOCAL_AUTH_APOTEKER_PASSWORD=
LOCAL_AUTH_KASIR_PASSWORD=

# Identitas staf aplikasi inti (wajib hanya saat AUTH_MODE=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Kunci Gemini hanya untuk server; model utama gemini-2.5-flash
GEMINI_API_KEY=

# Pilihan mode penyimpanan. Mode memory tidak menyimpan data (hanya untuk tes) dan mulai kosong.
STORAGE_MODE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_myitaru
MYITARU_QR_SECRET=

# Verifikasi Cloudflare Turnstile (rahasia hanya di server)
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_EXPECTED_HOSTNAME=
CLOUDFLARE_TURNSTILE_EXPECTED_ACTION=login

# Login pasien via OTP WhatsApp Cloud API (Meta). Kosongkan = login pasien nonaktif (503).
# Isi hanya di secret server, jangan di repositori.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nama template kategori Authentication (tombol copy code) yang sudah disetujui Meta
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=id
WHATSAPP_API_VERSION=v23.0
# Opsional: kunci HMAC hash OTP (bawaan memakai SESSION_SECRET)
OTP_HASH_SECRET=

# Pembayaran online tagihan pasien (rahasia hanya di server / `wrangler secret put`).
# Xendit Payments API v3. Kosongkan = pembayaran online nonaktif (UI: "bayar di kasir", POST 503).
XENDIT_SECRET_KEY=
# Token verifikasi webhook (Dashboard Xendit > Settings > Webhooks); dicek pada header x-callback-token
XENDIT_CALLBACK_TOKEN=
# Nama yang tampil di Virtual Account (opsional, bawaan MYITARU)
XENDIT_VA_DISPLAY_NAME=
# PayPal Orders v2 (terpisah). PayPal tidak mendukung IDR: wajib isi mata uang settlement + kurs tetap.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
# Mata uang yang didukung PayPal, mis. USD
PAYPAL_CURRENCY=
# Kurs: jumlah IDR per 1 unit PAYPAL_CURRENCY (mis. 16500). Kosong = PayPal tidak tersedia.
PAYPAL_IDR_PER_UNIT=
# Opsional: daftar id kanal yang diaktifkan, dipisah koma (kosong = semua kanal yang didukung).
# VA_BCA,VA_MANDIRI,VA_BRI,VA_BNI,VA_CIMB,EWALLET_GOPAY,EWALLET_SHOPEEPAY,EWALLET_OVO,EWALLET_DANA,EWALLET_LINKAJA,QRIS,PAYPAL
PAYMENT_CHANNELS=
# URL dasar web publik pasien untuk kembali dari e-wallet/PayPal, mis. https://pasien.contoh-rs.id
PAYMENT_RETURN_BASE_URL=
