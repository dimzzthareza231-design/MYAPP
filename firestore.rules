rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function active() { return verified() && exists(userPath()) && get(userPath()).data.aktif == true; }
    function role() { return get(userPath()).data.roleId; }
    function admin() { return active() && role() in ['super_admin', 'admin']; }
    function staff() { return active() && role() in ['super_admin', 'admin', 'direksi', 'dokter', 'perawat', 'bidan', 'apoteker', 'kasir', 'pendaftaran', 'rekam_medis', 'laboran', 'radiografer', 'manajemen_mutu', 'gizi', 'rehab_medik', 'it_support']; }
    function clinical() { return active() && role() in ['super_admin', 'admin', 'dokter', 'perawat', 'bidan', 'rekam_medis']; }
    function registration() { return clinical() || (active() && role() == 'pendaftaran'); }
    function validId(id) { return id is string && id.size() > 0 && id.size() <= 128; }
    function ownPatient(data) {
      return active() && role() in ['patient', 'viewer'] &&
        get(userPath()).data.no_rm is string && get(userPath()).data.no_rm.size() > 0 &&
        data.no_rm == get(userPath()).data.no_rm;
    }
    function userValid(data) {
      return data.keys().hasOnly(['id','uid','username','nama','email','photoURL','roleId','aktif','dibuatPada','isGoogleAuth','updatedAt','no_rm']) &&
        data.keys().hasAll(['nama','roleId','aktif']) && data.nama is string && data.nama.size() > 0 && data.nama.size() <= 160 &&
        data.aktif is bool && data.roleId in ['super_admin','admin','direksi','dokter','perawat','bidan','apoteker','kasir','pendaftaran','rekam_medis','laboran','radiografer','manajemen_mutu','gizi','rehab_medik','it_support','patient','viewer'] &&
        (!('no_rm' in data) || (data.no_rm is string && data.no_rm.size() <= 40));
    }
    function patientValid(data) {
      return data.keys().hasAll(['nama','no_rm']) &&
        data.keys().hasOnly(['id','no_rm','nik','nama','tanggal_lahir','tgl_lahir','jenis_kelamin','alamat','telepon','no_hp','golongan_darah','penjamin','status','keluhan_utama','diagnosa_primer','alergi','tanda_vital','resume_medis','soap','updatedAt']) &&
        data.nama is string && data.nama.size() > 0 && data.nama.size() <= 160 &&
        data.no_rm is string && data.no_rm.size() > 0 && data.no_rm.size() <= 40 &&
        (!('nik' in data) || (data.nik is string && data.nik.matches('^[0-9]{16}$')));
    }
    match /users/{uid} {
      allow get: if verified() && (request.auth.uid == uid || admin());
      allow list: if admin();
      // Bootstrap/identity provisioning occurs through a trusted administrator.
      // No self-created administrator, hard-coded email override, or password field.
      allow create: if validId(uid) && admin() && userValid(request.resource.data);
      allow update: if validId(uid) && userValid(request.resource.data) && (
        admin() || (active() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama','username','photoURL','updatedAt']))
      );
      allow delete: if false;
    }
    match /pasien/{id} {
      allow get, list: if staff() || ownPatient(resource.data);
      allow create: if validId(id) && registration() && patientValid(request.resource.data);
      allow update: if validId(id) && registration() && patientValid(request.resource.data) && request.resource.data.no_rm == resource.data.no_rm;
      allow delete: if false;
    }
    match /kunjungan/{id} {
      allow get, list: if staff() || ownPatient(resource.data);
      allow create, update: if validId(id) && registration() && request.resource.data.keys().hasAll(['pasien_id','tanggal','status']) && request.resource.data.pasien_id is string && request.resource.data.tanggal is string && request.resource.data.status is string;
      allow delete: if false;
    }
    match /dokter/{id} { allow read: if staff(); allow create, update: if admin() && validId(id); allow delete: if false; }
    match /perawat/{id} { allow read: if staff(); allow create, update: if admin() && validId(id); allow delete: if false; }
    match /hospital_settings/{id} { allow read: if staff(); allow create, update: if admin() && validId(id); allow delete: if false; }
    // Arbitrary legacy JSON blobs are never readable by a patient/viewer.
    match /system_data/{id} { allow read, create, update: if admin() && validId(id); allow delete: if false; }
    match /activity_logs/{id} {
      allow read: if admin() || (active() && resource.data.user.uid == request.auth.uid);
      allow create: if active() && validId(id) && request.resource.data.user.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /fcm_tokens/{id} {
      allow read: if admin() || (active() && resource.data.uid == request.auth.uid);
      allow create: if active() && request.resource.data.uid == request.auth.uid && ownPatient(request.resource.data);
      allow update: if active() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid && request.resource.data.no_rm == resource.data.no_rm && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['token','platform','userAgent','queueAlertsEnabled','labAlertsEnabled','active','updatedAt']);
      allow delete: if active() && resource.data.uid == request.auth.uid;
    }
    match /patient_notifications/{id} {
      allow read: if admin() || (active() && resource.data.recipientUid == request.auth.uid);
      allow create: if clinical();
      allow update: if active() && resource.data.recipientUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
      allow delete: if false;
    }
    match /test/{id} { allow get: if active(); allow list, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
