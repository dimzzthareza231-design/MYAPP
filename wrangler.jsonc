// Dua Worker dari satu kode: `--env public` (web publik pasien) dan `--env core` (aplikasi inti SIMK/RME).
// Data di Firestore project myitaru (secret FIRESTORE_SERVICE_ACCOUNT_JSON). Secret diisi dengan `wrangler secret put <NAMA> --env <public|core>`.
// Level atas = salinan env core: deploy otomatis Cloudflare (Workers Builds) memanggil `wrangler deploy` tanpa --env.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myitaru-core",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "build": { "command": "npm run cf:build" },
  "routes": [{ "pattern": "myitaru.my.id", "custom_domain": true }],
  "vars": {
    "APP_TARGET": "core",
    "CLOUDFLARE_WORKER": "1",
    "NODE_ENV": "production",
    "AUTH_MODE": "local",
    "STORAGE_MODE": "firestore",
    "FIRESTORE_DATABASE_ID": "(default)"
  },
  "assets": {
    "directory": "./dist/core",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "myitaru-db", "database_id": "80e76ffa-de80-4bfd-8863-30c640ab007f", "migrations_dir": "migrations" }
  ],
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  // Semua /api aplikasi inti diproses satu Durable Object agar data di memori tidak terpecah per isolate.
  "durable_objects": { "bindings": [{ "name": "CORE_STATE", "class_name": "CoreState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CoreState"] }],
  "alias": {
    "firebase-admin/app": "./worker/stubs/firebase-admin.ts",
    "firebase-admin/auth": "./worker/stubs/firebase-admin.ts",
    "firebase-admin/firestore": "./worker/stubs/firebase-admin.ts",
    "vite": "./worker/stubs/vite.ts"
  },
  "env": {
    "public": {
      "name": "myitaru-public",
      // Custom domain: Cloudflare membuat record DNS dan sertifikat TLS otomatis saat deploy.
      "routes": [{ "pattern": "www.myitaru.my.id", "custom_domain": true }],
      "vars": {
        "APP_TARGET": "public",
        "CLOUDFLARE_WORKER": "1",
        "NODE_ENV": "production",
        "AUTH_MODE": "local",
        "STORAGE_MODE": "firestore",
        "FIRESTORE_DATABASE_ID": "(default)"
      },
      "assets": {
        "directory": "./dist/public",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [
        // Ganti database_id dengan hasil `npx wrangler d1 create myitaru-db`.
        { "binding": "DB", "database_name": "myitaru-db", "database_id": "80e76ffa-de80-4bfd-8863-30c640ab007f", "migrations_dir": "migrations" }
      ],
      // Login: maks 5 percobaan per IP per endpoint per 60 detik, berlaku di semua isolate.
      "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
    },
    "core": {
      "name": "myitaru-core",
      // Custom domain: Cloudflare membuat record DNS dan sertifikat TLS otomatis saat deploy.
      "routes": [{ "pattern": "myitaru.my.id", "custom_domain": true }],
      "vars": {
        "APP_TARGET": "core",
        "CLOUDFLARE_WORKER": "1",
        "NODE_ENV": "production",
        "AUTH_MODE": "local",
        "STORAGE_MODE": "firestore",
        "FIRESTORE_DATABASE_ID": "(default)"
      },
      "assets": {
        "directory": "./dist/core",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "myitaru-db", "database_id": "80e76ffa-de80-4bfd-8863-30c640ab007f", "migrations_dir": "migrations" }
      ],
      // Login: maks 5 percobaan per IP per endpoint per 60 detik, berlaku di semua isolate.
      "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
      "durable_objects": { "bindings": [{ "name": "CORE_STATE", "class_name": "CoreState" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CoreState"] }]
    }
  }
}
